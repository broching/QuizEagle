# Gemini API Keys — get from Google AI Studio (aistudio.google.com)
# Use 3 different Google accounts for 3x the free quota
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# Convex (already set up in boilerplate)
NEXT_PUBLIC_CONVEX_URL=

# Clerk (already set up in boilerplate)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog — get from posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Cloudflare Turnstile — get from dash.cloudflare.com → Turnstile
# Dev test keys (always pass): site=1x00000000000000000000AA, secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
